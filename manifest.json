{
  "manifest_version": 3,
  "name": "抖音AI合集作者采集 1.1.4",
  "version": "1.1.4",
  "description": "从抖音推荐/精选中采集「挂载合集 + 作者声明：内容由AI生成」的作者 sec_uid",
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": [
    "*://www.douyin.com/*",
    "*://*.douyin.com/*",
    "*://*.iesdouyin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "抖音AI合集作者采集",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.douyin.com/*"],
      "js": ["content/parse.js", "content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
